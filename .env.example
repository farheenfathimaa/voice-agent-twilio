# --- service -------------------------------------------------------------
PUBLIC_BASE_URL=https://your-public-host.example.com   # ngrok/cloudflare URL, no trailing slash
LOG_LEVEL=INFO
ENVIRONMENT=dev

# --- twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TRANSFER_NUMBER=+15557654321           # human queue (must be verified on a trial account)

# --- providers ------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GOOGLE_API_KEY=AIzaxxxxxxxxxxxx       # Gemini via LiteLLM (gemini/* models)
OPENAI_API_KEY=                        # optional, only for openai/* models

LLM_MODEL=groq/llama-3.3-70b-versatile
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=groq
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI

# --- rag ------------------------------------------------------------------
EMBEDDINGS_PROVIDER=auto               # auto | fastembed | hashing | none
RAG_TOP_K=4

# --- conversation ---------------------------------------------------------
CONFIDENCE_THRESHOLD=0.6

# --- integrations ---------------------------------------------------------
CRM_BASE_URL=http://localhost:8001
CRM_API_KEY=dev-crm-key
N8N_WEBHOOK_URL=                       # e.g. http://host.docker.internal:5678/webhook/voice-call-summary
